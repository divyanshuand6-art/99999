NODE_ENV=development
PORT=4000
# Use your MongoDB Atlas Connect > Drivers connection string.
# URL-encode special characters in the database user's password.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/linkpulse?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
VISITOR_HASH_SECRET=replace-with-another-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
# Local development fallback only; set this to the deployed public API URL on Render.
PUBLIC_BASE_URL=http://localhost:4000
# Local Redis is optional. The API can classify events from the MongoDB outbox without Redis.
REDIS_URL=redis://127.0.0.1:6379
# Set false when using the standalone Redis worker; defaults to the free inline API processor.
INLINE_CLICK_PROCESSOR=true
# Local worker mode without Redis.
USE_REDIS=false
# Set these only for one-time admin bootstrap, then unset the password.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=use-a-long-unique-password-here
# BOOTSTRAP_ADMIN_NAME=LinkPulse Admin
TRUST_PROXY=false

# Demo checkout: every mock checkout succeeds but never charges money. Enable intentionally for a public demo.
MOCK_BILLING_ENABLED=true
